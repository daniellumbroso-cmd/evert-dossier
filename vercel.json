{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/generate.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/save-to-drive.js": {
      "maxDuration": 60
    },
    "api/export-pptx.js": {
      "maxDuration": 30
    },
    "api/campaign.js": {
      "maxDuration": 300
    },
    "api/mail-sync.js": {
      "maxDuration": 300
    },
    "api/agent/index-consultants.js": {
      "maxDuration": 300
    },
    "api/agent/match-offer.js": {
      "maxDuration": 300
    },
    "api/agent/ingest-offers.js": {
      "maxDuration": 300
    },
    "api/agent/push-draft.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
