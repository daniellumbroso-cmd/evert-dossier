# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://votre-app.vercel.app/api/auth/callback

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=...  # ID du dossier Drive partagé "Ever"T / Dossiers candidats"

# Session : clé de chiffrement du cookie, 32 caractères minimum (sinon aucune connexion n'est acceptée).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Boond (une clé pour toute la société)
BOOND_BASE_URL=https://ui.boondmanager.com/api
BOOND_CLIENT_TOKEN=...
BOOND_CLIENT_KEY=...
BOOND_USER_TOKEN=...

# App
VITE_APP_URL=https://votre-app.vercel.app
# Domaines Google autorisés à se connecter, séparés par des virgules
ALLOWED_DOMAIN=ever-t.fr
# Domaines internes ignorés par la synchro Gmail → Boond
INTERNAL_EMAIL_DOMAINS=ever-t.fr,ever-t.com
